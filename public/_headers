# Hashed JS/CSS never change for a given file name, so browsers can keep them for a year
# instead of re-checking on every visit (every re-check is a billed request).
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Plain images/icons from public/assets: keep for a week.
/assets/*
  Cache-Control: public, max-age=604800

# These must always be re-checked so a new deploy reaches users.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
